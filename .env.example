# Supabase connection. Both are safe to expose in a client bundle — the anon
# key only grants what the RLS policies in supabase/migrations allow.
#
# NOTE: this app has no authentication by design (single-user study tool).
# Anyone with the URL and this key can read the question bank and write
# attempts. Do not store anything sensitive in it.

VITE_SUPABASE_URL=https://your-project.supabase.co

# Lovable names this PUBLISHABLE_KEY; the Supabase dashboard calls it the
# anon/public key. Either variable name works.
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
